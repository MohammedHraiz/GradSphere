{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://gradsphere-backend-env.eba-3bhnapgz.eu-north-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "http://gradsphere-backend-env.eba-3bhnapgz.eu-north-1.elasticbeanstalk.com/files/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}